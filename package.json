{
  "name": "par-ici-tennis",
  "version": "1.0.0",
  "description": "Script to book tennis court in Paris automatically",
  "keywords": [
    "automation",
    "sport",
    "tennis",
    "padel"
  ],
  "homepage": "https://github.com/bertrandda/par-ici-tennis",
  "bugs": "https://github.com/bertrandda/par-ici-tennis/issues",
  "main": "index.js",
  "author": "Bertrand d'Aure",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bertrandda/par-ici-tennis.git"
  },
  "packageManager": "npm@11.6.2",
  "scripts": {
    "postinstall": "npx playwright install chromium",
    "start": "node index.js",
    "start-dry": "node index.js --dry-run",
    "start-dry-debug": "node index.js --dry-run --debug",
    "start-dry-headed": "node index.js --dry-run --headed",
    "start-dry-headed-debug": "node index.js --dry-run --headed --debug",
    "config:migrate": "node scripts/migrate-config.js --remove-source",
    "booking:list": "node scripts/booking-manager.js list",
    "wait": "node scripts/wait-8-am.js",
    "eslint": "eslint .",
    "test": "node --test"
  },
  "dependencies": {
    "@gradio/client": "^2.6.0",
    "dayjs": "^1.11.23",
    "ics": "^3.12.0",
    "playwright": "^1.63.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint": "^10.10.0",
    "globals": "^17.12.0"
  }
}
